{
	"name": "moneta",
	"private": true,
	"version": "1.1.0",
	"type": "module",
	"packageManager": "pnpm@12.4.2",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build && node guide/build.ts",
		"guide": "node guide/build.ts",
		"guide:screenshots": "playwright test -c guide/playwright.config.ts",
		"preview": "sirv build --single --port 4173",
		"icons": "pnpm --allow-build=sharp dlx @vite-pwa/assets-generator@1.0.2",
		"emoji": "node src/components/emoji-picker/generate.ts",
		"prepare": "husky && svelte-kit sync || echo ''",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/core/i18n/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations --silent",
		"check": "pnpm i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp fmt --check . && vp lint .",
		"format": "vp fmt .",
		"test:unit": "vp test",
		"test": "vp test --run",
		"test:e2e": "playwright test",
		"bench": "vp test bench --run"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.2",
		"@inlang/plugin-m-function-matcher": "2.3.4",
		"@inlang/plugin-message-format": "4.5.5",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.63.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.0",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^26",
		"@vite-pwa/sveltekit": "^1.1.0",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.0",
		"emojibase-data": "17.0.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"layerchart": "^2.9.1",
		"marked": "^18.1.2",
		"mode-watcher": "^1.1.0",
		"netlify-cli": "27.15.0",
		"shadcn-svelte": "^1.7.1",
		"sirv-cli": "^3.0.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.2",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plugin-mkcert": "^2.1.0",
		"vite-plugin-pwa": "^2.0.0",
		"workbox-window": "^7.4.1",
		"vite-plus": "catalog:"
	},
	"dependencies": {
		"@sqlite.org/sqlite-wasm": "3.53.4-build2",
		"@zxcvbn-ts/core": "4.2.0",
		"@zxcvbn-ts/language-common": "4.1.3",
		"@zxcvbn-ts/language-en": "4.1.1",
		"@zxcvbn-ts/language-pt-br": "4.1.1",
		"d3-shape": "^3.2.0",
		"fflate": "^0.8.3",
		"uuidv7": "^1.2.1"
	}
}
